{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "(gdb) Launch",
            "type": "cppdbg",
            "request": "launch",
            //"program": "${workspaceFolder}/bin/bootloader.elf",
            "program": "${workspaceFolder}/bin/kernel.elf",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceRoot}",
            "environment": [],
            "externalConsole": false,
            "miDebuggerServerAddress": "localhost:3333",
            "MIMode": "gdb",
            "miDebuggerPath": "riscv32-unknown-elf-gdb",
            "useExtendedRemote": true,
            "preLaunchTask": "Debug",
            "postDebugTask": "Terminate All Tasks",
            "hardwareBreakpoints": {
                "require": true,
                "limit": 4
            }
        }
    ]
}